<UserControl
    x:Class="MCServerLauncher.WinUI.View.Features.CreateInstance.PreCreate.PreCreateMinecraftInstance"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Button Content="{x:Bind Texts['Back'], Mode=OneWay}" Click="Back_Click" HorizontalAlignment="Left" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10" Padding="0,0,8,24">
                <Button Content="{x:Bind Texts['CreateUniversalMinecraftJavaInstance'], Mode=OneWay}" Click="Java_Click" HorizontalContentAlignment="Left" Padding="20,13" />
                <Button Content="{x:Bind Texts['CreateMinecraftForgeInstance'], Mode=OneWay}" Click="Forge_Click" HorizontalContentAlignment="Left" Padding="20,13" />
                <Button Content="{x:Bind Texts['CreateMinecraftNeoForgeInstance'], Mode=OneWay}" Click="NeoForge_Click" HorizontalContentAlignment="Left" Padding="20,13" />
                <Button Content="{x:Bind Texts['CreateMinecraftFabricInstance'], Mode=OneWay}" Click="Fabric_Click" HorizontalContentAlignment="Left" Padding="20,13" />
                <Button Content="{x:Bind Texts['CreateMinecraftQuiltInstance'], Mode=OneWay}" Click="Quilt_Click" HorizontalContentAlignment="Left" Padding="20,13" />
                <Button Content="{x:Bind Texts['CreateMinecraftBedrockInstance'], Mode=OneWay}" Click="Bedrock_Click" HorizontalContentAlignment="Left" Padding="20,13" />
                <Button Content="{x:Bind Texts['CreateMinecraftGeyserStandaloneInstance'], Mode=OneWay}" IsEnabled="False" />
                <Button Content="{x:Bind Texts['CreateMinecraftBungeeCordInstance'], Mode=OneWay}" IsEnabled="False" />
                <Button Content="{x:Bind Texts['CreateMinecraftWaterfallInstance'], Mode=OneWay}" IsEnabled="False" />
                <Button Content="{x:Bind Texts['CreateMinecraftVelocityInstance'], Mode=OneWay}" IsEnabled="False" />
                <Button Content="{x:Bind Texts['CreateMinecraftTravertineInstance'], Mode=OneWay}" IsEnabled="False" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
