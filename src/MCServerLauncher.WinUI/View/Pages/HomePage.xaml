<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MCServerLauncher.WinUI.Views.Pages.HomePage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">
    <ScrollViewer>
        <StackPanel Spacing="18" Padding="32">
            <TextBlock Text="{x:Bind Texts['Main_HomeNavMenu'], Mode=OneWay}" Style="{StaticResource PageTitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind Texts['HomeTip'], Mode=OneWay}" Style="{StaticResource PageSubtitleTextBlockStyle}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="{x:Bind Texts['Announcement'], Mode=OneWay}" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                    <TextBlock Text="{x:Bind AnnouncementText, Mode=OneTime}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
