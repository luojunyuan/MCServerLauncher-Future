<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MCServerLauncher.WinUI.Views.Pages.ResourceDownloadPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:models="using:MCServerLauncher.WinUI.Models">
    <Grid Padding="32" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind Texts['Main_ResDownloadNavMenu'], Mode=OneWay}" Style="{StaticResource PageTitleTextBlockStyle}" />
            <ComboBox Grid.Column="1" Width="260" ItemsSource="{x:Bind ViewModel.ProviderItems, Mode=OneWay}" SelectedIndex="{x:Bind ViewModel.SelectedProviderIndex, Mode=TwoWay}" SelectionChanged="Provider_SelectionChanged" />
            <Button Grid.Column="2" Content="{x:Bind Texts['Refresh'], Mode=OneWay}" Click="Refresh_Click" />
        </Grid>
        <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" Style="{StaticResource PageSubtitleTextBlockStyle}" />
        <Grid Grid.Row="2" ColumnSpacing="14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="1.4*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="{x:Bind Texts['ResDownload_InstanceCore'], Mode=OneWay}" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                    <ListView Grid.Row="1" x:Name="CoreList" ItemsSource="{x:Bind ViewModel.CoreItems, Mode=OneWay}" SelectionChanged="Core_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ResourceCoreItem">
                                <Grid Padding="8" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="{x:Bind Name, Mode=OneTime}" FontWeight="SemiBold" /><TextBlock Text="{x:Bind Description, Mode=OneTime}" TextWrapping="Wrap" Opacity="0.7" /></StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Tag, Mode=OneTime}" Opacity="0.7" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Bind Texts['MinecraftVersion'], Mode=OneWay}" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                    <ComboBox x:Name="MinecraftVersionBox" ItemsSource="{x:Bind ViewModel.MinecraftVersions, Mode=OneWay}" SelectionChanged="MinecraftVersion_SelectionChanged" />
                    <TextBlock Text="{x:Bind ViewModel.ErrorText, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="{x:Bind Texts['BuildVersion'], Mode=OneWay}" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.VersionItems, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ResourceVersionItem">
                                <Grid Padding="8" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="{x:Bind FileName, Mode=OneTime}" FontWeight="SemiBold" /><TextBlock Text="{x:Bind BuildVersion, Mode=OneTime}" Opacity="0.7" /><TextBlock Text="{x:Bind FileSize, Mode=OneTime}" Opacity="0.7" /></StackPanel>
                                    <Button Grid.Column="1" Content="{x:Bind Texts['Download'], Mode=OneWay}" Tag="{x:Bind Mode=OneTime}" Click="Download_Click" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"><ProgressBar Width="220" Maximum="100" Value="{x:Bind ViewModel.Progress, Mode=OneWay}" /><TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" VerticalAlignment="Center" /><Button Content="{x:Bind Texts['Cancel'], Mode=OneWay}" Command="{x:Bind ViewModel.CancelCommand, Mode=OneWay}" /></StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
