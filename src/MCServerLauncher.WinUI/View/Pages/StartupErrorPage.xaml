<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MCServerLauncher.WinUI.Views.Pages.StartupErrorPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">
    <Grid Padding="40">
        <StackPanel MaxWidth="720" Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="{x:Bind ProductName, Mode=OneTime}" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="{x:Bind Texts['ErrorDialogTip'], Mode=OneWay}" FontSize="18" />
            <TextBox Text="{x:Bind ErrorText, Mode=OneTime}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{x:Bind Texts['Exit'], Mode=OneWay}" Click="Exit_Click" />
                <Button Content="{x:Bind Texts['Restart'], Mode=OneWay}" Click="Restart_Click" />
                <Button Content="{x:Bind Texts['FeedbackViaGitHub'], Mode=OneWay}" Click="Feedback_Click" />
                <Button Content="{x:Bind Texts['Continue'], Mode=OneWay}" Click="Continue_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
