<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MCServerLauncher.WinUI.Views.Pages.InstanceManagerPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:models="using:MCServerLauncher.WinUI.Models">
  <Grid Padding="32" RowSpacing="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TextBlock Text="{x:Bind Texts['Main_InstanceManagerNavMenu'], Mode=OneWay}" Style="{StaticResource PageTitleTextBlockStyle}" />
    <TextBlock Grid.Row="1" Text="{x:Bind Texts['InstanceManagerTip'], Mode=OneWay}" Style="{StaticResource PageSubtitleTextBlockStyle}" />

    <Grid x:Name="FilterBar" Grid.Row="2" ColumnSpacing="8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <ComboBox
            MinWidth="150"
            MaxWidth="260"
            ItemsSource="{x:Bind ViewModel.DaemonFilterItems, Mode=OneWay}"
            SelectedIndex="{x:Bind ViewModel.SelectedDaemonIndex, Mode=TwoWay}"
            SelectionChanged="DaemonFilter_SelectionChanged"
            AutomationProperties.AutomationId="InstanceDaemonFilterComboBox" />
        <ComboBox
            Width="130"
            x:Name="StatusFilter"
            SelectedValuePath="Tag"
            SelectedValue="{x:Bind ViewModel.SelectedStatusFilter, Mode=TwoWay}"
            AutomationProperties.AutomationId="InstanceStatusFilterComboBox">
          <ComboBoxItem Content="{x:Bind Texts['AllRunningStatus'], Mode=OneWay}" Tag="All" />
          <ComboBoxItem Content="{x:Bind Texts['Running'], Mode=OneWay}" Tag="Running" />
          <ComboBoxItem Content="{x:Bind Texts['Stopped'], Mode=OneWay}" Tag="Stopped" />
          <ComboBoxItem Content="{x:Bind Texts['Crashed'], Mode=OneWay}" Tag="Crashed" />
        </ComboBox>
        <ToggleSwitch
            IsOn="{x:Bind ViewModel.AutoRefreshEnabled, Mode=TwoWay}"
            OnContent="{x:Bind Texts['AutoRefresh_On'], Mode=OneWay}"
            OffContent="{x:Bind Texts['AutoRefresh_Off'], Mode=OneWay}"
            AutomationProperties.AutomationId="InstanceAutoRefreshSwitch" />
        <ComboBox
            Width="120"
            ItemsSource="{x:Bind ViewModel.RefreshIntervals, Mode=OneWay}"
            DisplayMemberPath="Display"
            SelectedValuePath="Seconds"
            SelectedValue="{x:Bind ViewModel.RefreshIntervalSeconds, Mode=TwoWay}"
            AutomationProperties.AutomationId="InstanceRefreshIntervalComboBox" />
        <TextBox
            Width="220"
            PlaceholderText="{x:Bind Texts['Search'], Mode=OneWay}"
            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            AutomationProperties.AutomationId="InstanceSearchTextBox" />
        <Button
            Content="{x:Bind Texts['Refresh'], Mode=OneWay}"
            Command="{x:Bind ViewModel.RefreshCommand, Mode=OneTime}"
            AutomationProperties.AutomationId="InstanceRefreshButton" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="3">
      <ScrollViewer x:Name="InstanceScrollViewer" Margin="0,4,0,0">
        <muxc:ItemsRepeater x:Name="InstanceItems" ItemsSource="{x:Bind ViewModel.FilteredInstances, Mode=OneWay}">
          <muxc:ItemsRepeater.Layout>
            <muxc:UniformGridLayout MinItemWidth="360" MinItemHeight="250" MinColumnSpacing="10" MinRowSpacing="10" />
          </muxc:ItemsRepeater.Layout>
          <muxc:ItemsRepeater.ItemTemplate>
            <DataTemplate x:DataType="models:InstanceCardModel">
              <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,10">
                <Grid RowSpacing="10">
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{x:Bind InstanceName, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" />
                    <Border Background="{ThemeResource SystemControlBackgroundAccentBrush}" CornerRadius="10" Padding="8,2">
                      <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" FontWeight="SemiBold" />
                    </Border>
                  </StackPanel>

                  <Grid Grid.Row="1" ColumnSpacing="12" RowSpacing="6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="{x:Bind Texts['InstanceType'], Mode=OneWay}" />
                    <TextBlock Grid.Row="1" Text="{x:Bind Texts['Version'], Mode=OneWay}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind InstanceType, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind Version, Mode=OneWay}" TextWrapping="Wrap" />
                  </Grid>

                  <Grid Grid.Row="2" ColumnSpacing="8" RowSpacing="6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="116" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="{x:Bind Texts['Daemon_CpuUsage'], Mode=OneWay}" />
                    <TextBlock Grid.Row="1" Text="{x:Bind Texts['Daemon_MemoryUsage'], Mode=OneWay}" />
                    <ProgressBar Grid.Column="1" Maximum="100" Value="{x:Bind CpuUsageProgress, Mode=OneWay}" VerticalAlignment="Center" />
                    <ProgressBar Grid.Row="1" Grid.Column="1" Maximum="100" Value="{x:Bind MemoryUsageProgress, Mode=OneWay}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{x:Bind CpuUsageText, Mode=OneWay}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{x:Bind MemoryUsageText, Mode=OneWay}" HorizontalAlignment="Right" />
                  </Grid>

                  <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="{x:Bind Texts['View'], Mode=OneWay}" Tag="{x:Bind Mode=OneTime}" Click="OpenConsole_Click" />
                    <Button Content="{x:Bind Texts['More'], Mode=OneWay}">
                      <Button.Flyout>
                        <MenuFlyout>
                          <MenuFlyoutItem Text="{x:Bind Texts['Start'], Mode=OneWay}" Tag="{x:Bind Mode=OneTime}" IsEnabled="{x:Bind CanStart, Mode=OneWay}" Click="StartInstance_Click" />
                          <MenuFlyoutItem Text="{x:Bind Texts['Stop'], Mode=OneWay}" Tag="{x:Bind Mode=OneTime}" IsEnabled="{x:Bind CanStop, Mode=OneWay}" Click="StopInstance_Click" />
                          <MenuFlyoutItem Text="{x:Bind Texts['Restart'], Mode=OneWay}" Tag="{x:Bind Mode=OneTime}" IsEnabled="{x:Bind CanRestart, Mode=OneWay}" Click="RestartInstance_Click" />
                          <MenuFlyoutSeparator />
                          <MenuFlyoutItem Text="{x:Bind Texts['Kill'], Mode=OneWay}" Tag="{x:Bind Mode=OneTime}" IsEnabled="{x:Bind CanKill, Mode=OneWay}" Click="KillInstance_Click" />
                          <MenuFlyoutSeparator />
                          <MenuFlyoutItem Text="{x:Bind Texts['Delete'], Mode=OneWay}" Tag="{x:Bind Mode=OneTime}" Click="DeleteInstance_Click" />
                        </MenuFlyout>
                      </Button.Flyout>
                    </Button>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </muxc:ItemsRepeater.ItemTemplate>
        </muxc:ItemsRepeater>
      </ScrollViewer>

      <Grid
          x:Name="LoadingLayer"
          Visibility="{x:Bind BoolToVisibility(ViewModel.IsLoading), Mode=OneWay}"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          Opacity="0.92">
        <muxc:ProgressRing IsActive="True" Width="64" Height="64" />
      </Grid>

      <Grid x:Name="ErrorLayer" Visibility="Collapsed" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="520">
          <TextBlock x:Name="ErrorSymbol" FontSize="64" HorizontalAlignment="Center" />
          <TextBlock x:Name="ErrorTitle" Style="{StaticResource PageTitleTextBlockStyle}" HorizontalAlignment="Center" TextAlignment="Center" />
          <TextBlock x:Name="ErrorDescription" TextWrapping="Wrap" TextAlignment="Center" />
          <Button x:Name="ErrorActionButton" Margin="0,10,0,0" Click="ErrorAction_Click" HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Page>
