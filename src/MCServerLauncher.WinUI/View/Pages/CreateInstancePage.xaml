<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MCServerLauncher.WinUI.Views.Pages.CreateInstancePage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:MCServerLauncher.WinUI.Views.Components.Generic">
    <Grid Padding="32" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock Text="{x:Bind Texts['Main_CreateInstanceNavMenu'], Mode=OneWay}" Style="{StaticResource PageTitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind Texts['PreCreateInstanceTip'], Mode=OneWay}" Style="{StaticResource PageSubtitleTextBlockStyle}" />
        </StackPanel>
        <Grid Grid.Row="1">
            <Frame x:Name="WizardFrame" />
            <components:StopTipLayer
                x:Name="AvailabilityTip"
                Visibility="Collapsed"
                AutomationProperties.AutomationId="CreateInstanceConnectDaemonButton" />
        </Grid>
    </Grid>
</Page>
