<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MCServerLauncher.WinUI.Views.Pages.CreateInstancePage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid Padding="32" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock Text="{x:Bind Texts['Main_CreateInstanceNavMenu'], Mode=OneWay}" Style="{StaticResource PageTitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind Texts['PreCreateInstanceTip'], Mode=OneWay}" Style="{StaticResource PageSubtitleTextBlockStyle}" />
        </StackPanel>
        <Grid Grid.Row="1">
            <Frame x:Name="WizardFrame" />
            <muxc:InfoBar
                x:Name="AvailabilityBar"
                IsOpen="False"
                IsClosable="False"
                Severity="Error"
                VerticalAlignment="Bottom"
                Margin="0,0,0,12">
                <muxc:InfoBar.ActionButton>
                    <Button
                        Content="{x:Bind Texts['ConnectDaemon'], Mode=OneWay}"
                        Click="ConnectDaemon_Click"
                        AutomationProperties.AutomationId="CreateInstanceConnectDaemonButton" />
                </muxc:InfoBar.ActionButton>
            </muxc:InfoBar>
        </Grid>
    </Grid>
</Page>
