<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MCServerLauncher.WinUI.Views.Components.SettingCard.ActionSettingCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="100" d:DesignWidth="800">
    <Border Style="{StaticResource SettingsCardBorderStyle}">
        <Grid VerticalAlignment="Center" Margin="0,10,0,10">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon x:Name="SettingIcon" Grid.RowSpan="2" Margin="5,15,20,15"
                      Glyph="{x:Bind SettingIconGlyph, Mode=OneWay}" />
            <TextBlock Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,2"
                       FontSize="13" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"
                       Text="{x:Bind SettingTitle, Mode=OneWay}" />
            <TextBlock Grid.Column="1" Grid.Row="1" VerticalAlignment="Top"
                       Margin="0,2,20,5" Opacity="0.615" FontSize="12" TextTrimming="CharacterEllipsis"
                       TextWrapping="Wrap" Text="{x:Bind SettingDescription, Mode=OneWay}" />
            <Button x:Name="SettingButton" Grid.Column="2" Grid.RowSpan="2" VerticalAlignment="Center"
                    Style="{ThemeResource AccentButtonStyle}"
                    Content="{x:Bind SettingButtonText, Mode=OneWay}"
                    Command="{x:Bind SettingButtonCommand, Mode=OneWay}"
                    IsEnabled="{x:Bind SettingButtonIsEnabled, Mode=OneWay}" />
        </Grid>
    </Border>
</UserControl>
