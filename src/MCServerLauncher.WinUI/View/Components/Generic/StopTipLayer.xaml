<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MCServerLauncher.WinUI.Views.Components.Generic.StopTipLayer"
    x:Name="ControlRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MCServerLauncher.WinUI.Views.Components.Generic">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="1"
                   VerticalAlignment="Center" HorizontalAlignment="Center"
                   Text="{x:Bind Symbol, Mode=OneWay}"
                   FontSize="80" />
        <TextBlock Grid.Row="2"
                   VerticalAlignment="Center" HorizontalAlignment="Center"
                   Text="{x:Bind StopTip, Mode=OneWay}"
                   Style="{StaticResource TitleTextBlock}" />
        <TextBlock Grid.Row="3"
                   VerticalAlignment="Center" HorizontalAlignment="Center"
                   Text="{x:Bind StopDescription, Mode=OneWay}"
                   Style="{StaticResource BodyTextBlock}"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Margin="0,10,0,0" />
        <Button Grid.Row="4"
                VerticalAlignment="Top" HorizontalAlignment="Center"
                Width="120" Margin="0,20,0,0"
                Content="{x:Bind ButtonText, Mode=OneWay}"
                Command="{x:Bind ButtonCommand, Mode=OneWay}"
                CommandParameter="{x:Bind ButtonCommandParameter, Mode=OneWay}"
                Visibility="{x:Bind local:StopTipLayer.TextToVisibility(ButtonText), Mode=OneWay}" />
    </Grid>
</UserControl>
