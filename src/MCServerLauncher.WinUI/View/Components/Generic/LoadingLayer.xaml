<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MCServerLauncher.WinUI.Views.Components.Generic.LoadingLayer"
    x:Name="ControlRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.RowSpan="3" Grid.ColumnSpan="3" Background="Gray" Opacity="0.15" CornerRadius="4" />
        <muxc:ProgressRing
            Margin="0,-10,0,0"
            Grid.Row="1"
            Grid.Column="1"
            HorizontalAlignment="Center"
            Height="65"
            Width="65"
            IsActive="True" />
    </Grid>
</UserControl>
