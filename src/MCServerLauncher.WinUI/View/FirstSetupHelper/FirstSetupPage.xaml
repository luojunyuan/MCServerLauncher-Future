<Page
    x:Class="MCServerLauncher.WinUI.Views.Pages.FirstSetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:models="using:MCServerLauncher.WinUI.Models">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <NavigationView
        x:Name="StepNavigation"
        Grid.Row="0"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        PaneDisplayMode="Top"
        SelectionChanged="StepNavigation_SelectionChanged">
      <NavigationView.MenuItems>
        <NavigationViewItem x:Name="LanguageNavigationItem" Tag="0" Content="{x:Bind Texts['FirstSetup_TimeLanguageMenu'], Mode=OneWay}">
          <NavigationViewItem.Icon><SymbolIcon Symbol="World" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem x:Name="EulaNavigationItem" Tag="1" Content="{x:Bind Texts['FirstSetup_EulaMenu'], Mode=OneWay}">
          <NavigationViewItem.Icon><SymbolIcon Symbol="Document" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem x:Name="DaemonNavigationItem" Tag="2" Content="{x:Bind Texts['FirstSetup_ConnectDaemonMenu'], Mode=OneWay}">
          <NavigationViewItem.Icon><SymbolIcon Symbol="Link" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem x:Name="WelcomeNavigationItem" Tag="3" Content="{x:Bind Texts['FirstSetup_WelcomeMenu'], Mode=OneWay}">
          <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>
    </NavigationView>

    <Grid Grid.Row="1" Padding="40,24">
      <Grid x:Name="LanguageStep">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
          <TextBlock Text="{x:Bind Texts['FirstSetup_SetLanguageHint'], Mode=OneWay}" FontSize="34" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{x:Bind Texts['FirstSetup_SetLanguageHintReverse'], Mode=OneWay}" FontSize="22" TextWrapping="Wrap" />
        </StackPanel>
        <ComboBox x:Name="LanguageComboBox" Grid.Column="1" ItemsSource="{x:Bind LanguageNames, Mode=OneWay}" SelectedIndex="{x:Bind LanguageIndex, Mode=TwoWay}" Width="260" HorizontalAlignment="Center" VerticalAlignment="Center" SelectionChanged="LanguageChanged" />
      </Grid>

      <Grid x:Name="EulaStep" Visibility="Collapsed">
        <StackPanel MaxWidth="850" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
          <TextBlock Text="{x:Bind Texts['FirstSetup_EulaMenu'], Mode=OneWay}" FontSize="30" FontWeight="SemiBold" />
          <TextBlock Text="{x:Bind Texts['FirstSetup_EulaOnlineTip'], Mode=OneWay}" TextWrapping="Wrap" />
          <TextBlock Text="{x:Bind Texts['FirstSetup_EulaUrlLabel'], Mode=OneWay}" Opacity="0.72" />
          <Border Padding="16,12" BorderThickness="1" CornerRadius="4">
            <TextBlock x:Name="EulaUrlTextBlock" TextWrapping="Wrap" />
          </Border>
          <Button x:Name="OpenEulaButton" Content="{x:Bind Texts['FirstSetup_EulaOpenInBrowser'], Mode=OneWay}" Click="OpenEulaInBrowser" HorizontalAlignment="Left" />
        </StackPanel>
      </Grid>

      <Grid x:Name="DaemonStep" Visibility="Collapsed">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,28,0" VerticalAlignment="Center" Spacing="14">
          <TextBlock Text="{x:Bind Texts['FirstSetup_ConnectDaemonMenu'], Mode=OneWay}" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{x:Bind Texts['FirstSetup_ConnectDaemonTip'], Mode=OneWay}" TextWrapping="Wrap" />
          <TextBlock x:Name="DaemonErrorText" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <Grid Grid.Column="1" VerticalAlignment="Center">
          <StackPanel x:Name="LocalChoicePanel" Spacing="12">
            <TextBlock Text="{x:Bind Texts['FirstSetup_DaemonLocalQuestion'], Mode=OneWay}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind Texts['FirstSetup_DaemonLocalQuestionTip'], Mode=OneWay}" TextWrapping="Wrap" />
            <Button x:Name="UseLocalDaemonButton" Content="{x:Bind Texts['FirstSetup_DaemonUseLocal'], Mode=OneWay}" Click="UseLocalDaemon" />
            <Button x:Name="UseRemoteDaemonButton" Content="{x:Bind Texts['FirstSetup_DaemonSkipLocalUseRemote'], Mode=OneWay}" Click="UseRemoteDaemon" />
          </StackPanel>
          <StackPanel x:Name="RemoteSetupPanel" Visibility="Collapsed" Spacing="12">
            <Button x:Name="DaemonActionButton" Content="{x:Bind Texts['ConnectDaemon'], Mode=OneWay}" Click="AddDaemonConnection" />
            <ListView x:Name="DaemonListView" ItemsSource="{x:Bind AddedDaemons, Mode=OneTime}" MaxHeight="240">
              <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:DaemonConfigModel">
                  <Grid Padding="4" ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="{x:Bind EditText, Mode=OneWay}" Click="EditDaemonConnection" Tag="{x:Bind Mode=OneTime}" />
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
          </StackPanel>
        </Grid>
      </Grid>

      <Grid x:Name="WelcomeStep" Visibility="Collapsed">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
          <TextBlock Text="{x:Bind Texts['FirstSetup_SetupFinishedWelcome'], Mode=OneWay}" FontSize="28" TextWrapping="Wrap" />
          <TextBlock Text="MCServerLauncher" FontSize="42" FontWeight="SemiBold" />
          <TextBlock Text="Future" FontSize="42" Foreground="#00E396" FontWeight="SemiBold" />
        </StackPanel>
        <Image Grid.Column="1" Source="/Resources/MCServerLauncherFuture.png" Height="230" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Grid>
    </Grid>

    <Border Grid.Row="2" Padding="20" BorderThickness="0,1,0,0">
      <Grid>
        <Button x:Name="RefuseButton" Content="{x:Bind Texts['Disagree'], Mode=OneWay}" Click="RefuseEula" Visibility="Collapsed" HorizontalAlignment="Left" />
        <Button x:Name="AcceptButton" Content="{x:Bind AcceptButtonText, Mode=OneWay}" Click="AcceptEula" Visibility="Collapsed" HorizontalAlignment="Right" IsEnabled="False" />
        <Button x:Name="DaemonSkipButton" Content="{x:Bind Texts['TempSkip'], Mode=OneWay}" Click="SkipDaemon" Visibility="Collapsed" HorizontalAlignment="Left" />
        <Button x:Name="ContinueButton" Content="{x:Bind ContinueButtonText, Mode=OneWay}" Click="Continue_Click" HorizontalAlignment="Right" />
      </Grid>
    </Border>
  </Grid>
</Page>
