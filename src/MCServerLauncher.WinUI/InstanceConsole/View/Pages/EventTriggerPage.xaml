<UserControl
    x:Class="MCServerLauncher.WinUI.InstanceConsole.View.Pages.EventTriggerPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:models="using:MCServerLauncher.WinUI.Models">
    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <muxc:InfoBar x:Name="MultiSelectTipBar" Grid.Row="0" IsOpen="True" IsClosable="True" Severity="Informational" Message="{x:Bind Texts['MultiSelectTip'], Mode=OneWay}" Closed="MultiSelectTipBar_Closed" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button Content="{x:Bind Texts['Add'], Mode=OneWay}" Click="Add_Click" AutomationProperties.AutomationId="EventRuleAddButton" />
            <Button Content="{x:Bind Texts['Import'], Mode=OneWay}" Click="Import_Click" AutomationProperties.AutomationId="EventRuleImportButton" />
            <Button Content="{x:Bind Texts['Export'], Mode=OneWay}" Click="Export_Click" AutomationProperties.AutomationId="EventRuleExportButton" />
            <Button Content="{x:Bind Texts['Save'], Mode=OneWay}" Click="Save_Click" AutomationProperties.AutomationId="EventRuleSaveButton" />
            <Button Content="{x:Bind Texts['Refresh'], Mode=OneWay}" Click="Reload_Click" AutomationProperties.AutomationId="EventRuleRefreshButton" />
        </StackPanel>
        <Grid Grid.Row="2">
            <ListView x:Name="RulesListView" ItemsSource="{x:Bind Rules, Mode=OneWay}" SelectionMode="Extended">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:EventRuleModel">
                        <Grid Padding="4" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind Description, Mode=OneWay}" TextTrimming="CharacterEllipsis" Opacity="0.72" />
                                <TextBlock Text="{x:Bind Summary, Mode=OneWay}" Opacity="0.62" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                <Button Content="{x:Bind Texts['Edit'], Mode=OneWay}" Tag="{x:Bind Mode=OneTime}" Click="Edit_Click" />
                                <Button Content="{x:Bind Texts['Copy'], Mode=OneWay}" Tag="{x:Bind Mode=OneTime}" Click="Copy_Click" />
                                <Button Content="{x:Bind Texts['Delete'], Mode=OneWay}" Tag="{x:Bind Mode=OneTime}" Click="Delete_Click" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" IsOn="{x:Bind IsEnabled, Mode=TwoWay}" OnContent="{x:Bind Texts['On'], Mode=OneWay}" OffContent="{x:Bind Texts['Off'], Mode=OneWay}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="Collapsed">
                <TextBlock Text="{x:Bind Texts['NothingHere'], Mode=OneWay}" Style="{StaticResource SectionHeaderTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock Text="{x:Bind Texts['EventTrigger_EmptyRules'], Mode=OneWay}" TextWrapping="Wrap" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
