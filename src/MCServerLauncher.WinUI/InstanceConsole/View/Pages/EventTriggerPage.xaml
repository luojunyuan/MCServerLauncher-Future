<UserControl
    x:Class="MCServerLauncher.WinUI.InstanceConsole.View.Pages.EventTriggerPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:models="using:MCServerLauncher.WinUI.Models"
    xmlns:components="using:MCServerLauncher.WinUI.Views.Components.Generic">
    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <muxc:InfoBar x:Name="MultiSelectTipBar" Grid.Row="0" IsOpen="True" IsClosable="True" Severity="Informational" Message="{x:Bind Texts['MultiSelectTip'], Mode=OneWay}" Closed="MultiSelectTipBar_Closed" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button Click="Add_Click" AutomationProperties.AutomationId="EventRuleAddButton">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="16" />
                    <TextBlock Text="{x:Bind Texts['Add'], Mode=OneWay}" />
                </StackPanel>
            </Button>
            <Button Click="Import_Click" AutomationProperties.AutomationId="EventRuleImportButton">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE898;" FontSize="16" />
                    <TextBlock Text="{x:Bind Texts['Import'], Mode=OneWay}" />
                </StackPanel>
            </Button>
            <Button Click="Export_Click" AutomationProperties.AutomationId="EventRuleExportButton">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72E;" FontSize="16" />
                    <TextBlock Text="{x:Bind Texts['Export'], Mode=OneWay}" />
                </StackPanel>
            </Button>
            <Button Click="Save_Click" AutomationProperties.AutomationId="EventRuleSaveButton">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE74E;" FontSize="16" />
                    <TextBlock Text="{x:Bind Texts['Save'], Mode=OneWay}" />
                </StackPanel>
            </Button>
            <Button Click="Reload_Click" AutomationProperties.AutomationId="EventRuleRefreshButton">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="16" />
                    <TextBlock Text="{x:Bind Texts['Refresh'], Mode=OneWay}" />
                </StackPanel>
            </Button>
        </StackPanel>
        <Grid Grid.Row="2">
            <ListView x:Name="RulesListView" ItemsSource="{x:Bind Rules, Mode=OneWay}" SelectionMode="Extended">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:EventRuleModel">
                        <Grid Padding="4" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind Description, Mode=OneWay}" TextTrimming="CharacterEllipsis" Opacity="0.72" />
                                <TextBlock Text="{x:Bind Summary, Mode=OneWay}" Opacity="0.62" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                <Button Tag="{x:Bind Mode=OneTime}" Click="Edit_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                        <TextBlock Text="{x:Bind Texts['Edit'], Mode=OneWay}" />
                                    </StackPanel>
                                </Button>
                                <Button Tag="{x:Bind Mode=OneTime}" Click="Copy_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                        <TextBlock Text="{x:Bind Texts['Copy'], Mode=OneWay}" />
                                    </StackPanel>
                                </Button>
                                <Button Tag="{x:Bind Mode=OneTime}" Click="Delete_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                        <TextBlock Text="{x:Bind Texts['Delete'], Mode=OneWay}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" IsOn="{x:Bind IsEnabled, Mode=TwoWay}" OnContent="{x:Bind Texts['On'], Mode=OneWay}" OffContent="{x:Bind Texts['Off'], Mode=OneWay}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <components:StopTipLayer x:Name="EmptyState"
                                     Visibility="Collapsed"
                                     Symbol="🧾"
                                     StopTip="{x:Bind Texts['NothingHere'], Mode=OneWay}"
                                     StopDescription="{x:Bind Texts['EventTrigger_EmptyRules'], Mode=OneWay}"
                                     ButtonText="{x:Bind Texts['Add'], Mode=OneWay}"
                                     ButtonCommand="{x:Bind AddRuleCommand, Mode=OneTime}" />
        </Grid>
    </Grid>
</UserControl>
