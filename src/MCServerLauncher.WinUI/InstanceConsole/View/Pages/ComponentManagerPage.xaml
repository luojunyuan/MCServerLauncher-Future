<UserControl
    x:Class="MCServerLauncher.WinUI.InstanceConsole.View.Pages.ComponentManagerPage"
    x:Name="PageRoot"
    AllowDrop="True"
    DragOver="Page_DragOver"
    Drop="Page_Drop"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:models="using:MCServerLauncher.WinUI.Models">
    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel x:Name="ComponentToolbar" Orientation="Horizontal" Spacing="8">
            <Button Content="{x:Bind AddComponentText, Mode=OneWay}" Click="AddComponent_Click" AutomationProperties.AutomationId="ComponentAddButton" />
            <Button Content="{x:Bind Texts['Refresh'], Mode=OneWay}" Click="LoadComponents_Click" AutomationProperties.AutomationId="ComponentRefreshButton" />
        </StackPanel>
        <muxc:TabView x:Name="ComponentTabs" Grid.Row="1" SelectionChanged="ComponentKind_SelectionChanged">
            <muxc:TabViewItem x:Name="ModsTab" Header="{x:Bind Texts['Mods'], Mode=OneWay}">
                <ListView x:Name="ModsList" SelectionMode="None">
                    <ListView.ItemTemplate><DataTemplate x:DataType="models:ComponentFileModel"><Grid ColumnSpacing="12" Padding="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{x:Bind DisplayText, Mode=OneWay}" TextWrapping="Wrap" /><TextBlock Text="{x:Bind ClientWarningText, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCautionBrush}" TextWrapping="Wrap" /></StackPanel><Button Grid.Column="1" Content="{x:Bind ToggleText, Mode=OneWay}" Click="ToggleComponent_Click" Tag="{x:Bind Mode=OneTime}" /><Button Grid.Column="2" Content="{x:Bind Texts['ComponentManager_Locate'], Mode=OneWay}" Click="LocateComponent_Click" Tag="{x:Bind Mode=OneTime}" /><Button Grid.Column="3" Content="{x:Bind Texts['Delete'], Mode=OneWay}" Click="DeleteComponent_Click" Tag="{x:Bind Mode=OneTime}" /></Grid></DataTemplate></ListView.ItemTemplate>
                </ListView>
            </muxc:TabViewItem>
            <muxc:TabViewItem x:Name="PluginsTab" Header="{x:Bind Texts['Plugins'], Mode=OneWay}">
                <ListView x:Name="PluginsList" SelectionMode="None">
                    <ListView.ItemTemplate><DataTemplate x:DataType="models:ComponentFileModel"><Grid ColumnSpacing="12" Padding="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{x:Bind DisplayText, Mode=OneWay}" TextWrapping="Wrap" /><Button Grid.Column="1" Content="{x:Bind ToggleText, Mode=OneWay}" Click="ToggleComponent_Click" Tag="{x:Bind Mode=OneTime}" /><Button Grid.Column="2" Content="{x:Bind Texts['ComponentManager_Locate'], Mode=OneWay}" Click="LocateComponent_Click" Tag="{x:Bind Mode=OneTime}" /><Button Grid.Column="3" Content="{x:Bind Texts['Delete'], Mode=OneWay}" Click="DeleteComponent_Click" Tag="{x:Bind Mode=OneTime}" /></Grid></DataTemplate></ListView.ItemTemplate>
                </ListView>
            </muxc:TabViewItem>
        </muxc:TabView>
        <TextBlock x:Name="ComponentsStateText" Grid.Row="1" VerticalAlignment="Bottom" Margin="8" TextWrapping="Wrap" Opacity="0.72" IsHitTestVisible="False" />
    </Grid>
</UserControl>
