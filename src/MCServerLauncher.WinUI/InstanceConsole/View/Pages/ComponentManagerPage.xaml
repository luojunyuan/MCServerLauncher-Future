<UserControl
    x:Class="MCServerLauncher.WinUI.InstanceConsole.View.Pages.ComponentManagerPage"
    x:Name="PageRoot"
    AllowDrop="True"
    DragOver="Page_DragOver"
    Drop="Page_Drop"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:models="using:MCServerLauncher.WinUI.Models"
    xmlns:local="using:MCServerLauncher.WinUI.Core"
    xmlns:ge="using:MCServerLauncher.WinUI.Views.Components.Generic">
    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel x:Name="ComponentToolbar" Orientation="Horizontal" Spacing="8">
            <Button Content="{x:Bind AddComponentText, Mode=OneWay}" Click="AddComponent_Click" AutomationProperties.AutomationId="ComponentAddButton" />
            <Button Content="{x:Bind Texts['Refresh'], Mode=OneWay}" Click="LoadComponents_Click" AutomationProperties.AutomationId="ComponentRefreshButton" />
        </StackPanel>
        <muxc:TabView x:Name="ComponentTabs" Grid.Row="1" SelectionChanged="ComponentKind_SelectionChanged">
            <muxc:TabViewItem x:Name="ModsTab" Header="{x:Bind Texts['Mods'], Mode=OneWay}">
                <Grid>
                    <ListView x:Name="ModsList" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ComponentFileModel">
                                <Grid ColumnSpacing="12" Padding="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center"
                                             Fill="{x:Bind local:Converters.BoolToDotBrush(IsEnabled), Mode=OneWay}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <Border Padding="6,1" CornerRadius="8" Background="#FFD83B01" VerticalAlignment="Center"
                                                    Visibility="{x:Bind local:Converters.ClientSideBadgeVisibility(IsClientSideOnly), Mode=OneWay}">
                                                <TextBlock Text="{x:Bind Texts['ComponentManager_ClientSideBadge'], Mode=OneWay}" FontSize="10" Foreground="White" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Description, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind ClientWarningText, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCautionBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <muxc:DropDownButton Grid.Column="2" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE712;" FontSize="14" />
                                        <muxc:DropDownButton.Flyout>
                                            <MenuFlyout Placement="Bottom">
                                                <MenuFlyoutItem Text="{x:Bind ToggleText, Mode=OneWay}" Tag="{x:Bind Mode=OneTime}" Click="ToggleComponent_Click">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE73E;" FontSize="16" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="{x:Bind Texts['ComponentManager_Locate'], Mode=OneWay}" Tag="{x:Bind Mode=OneTime}" Click="LocateComponent_Click">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="{x:Bind Texts['Delete'], Mode=OneWay}" Tag="{x:Bind Mode=OneTime}" Click="DeleteComponent_Click">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE74D;" FontSize="16" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </muxc:DropDownButton.Flyout>
                                    </muxc:DropDownButton>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <ge:StopTipLayer x:Name="ModsEmptyTip"
                                     Symbol="📦"
                                     StopTip="{x:Bind Texts['NothingHere'], Mode=OneWay}"
                                     StopDescription="{x:Bind Texts['ComponentManager_EmptyMods'], Mode=OneWay}"
                                     ButtonText="{x:Bind Texts['ComponentManager_AddMod'], Mode=OneWay}"
                                     ButtonCommand="{x:Bind AddComponentCommand, Mode=OneWay}" />
                </Grid>
            </muxc:TabViewItem>
            <muxc:TabViewItem x:Name="PluginsTab" Header="{x:Bind Texts['Plugins'], Mode=OneWay}">
                <Grid>
                    <ListView x:Name="PluginsList" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ComponentFileModel">
                                <Grid ColumnSpacing="12" Padding="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center"
                                             Fill="{x:Bind local:Converters.BoolToDotBrush(IsEnabled), Mode=OneWay}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <Border Padding="6,1" CornerRadius="8" Background="#FFD83B01" VerticalAlignment="Center"
                                                    Visibility="{x:Bind local:Converters.ClientSideBadgeVisibility(IsClientSideOnly), Mode=OneWay}">
                                                <TextBlock Text="{x:Bind Texts['ComponentManager_ClientSideBadge'], Mode=OneWay}" FontSize="10" Foreground="White" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Description, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind ClientWarningText, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCautionBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <muxc:DropDownButton Grid.Column="2" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE712;" FontSize="14" />
                                        <muxc:DropDownButton.Flyout>
                                            <MenuFlyout Placement="Bottom">
                                                <MenuFlyoutItem Text="{x:Bind ToggleText, Mode=OneWay}" Tag="{x:Bind Mode=OneTime}" Click="ToggleComponent_Click">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE73E;" FontSize="16" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="{x:Bind Texts['ComponentManager_Locate'], Mode=OneWay}" Tag="{x:Bind Mode=OneTime}" Click="LocateComponent_Click">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="{x:Bind Texts['Delete'], Mode=OneWay}" Tag="{x:Bind Mode=OneTime}" Click="DeleteComponent_Click">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE74D;" FontSize="16" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </muxc:DropDownButton.Flyout>
                                    </muxc:DropDownButton>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <ge:StopTipLayer x:Name="PluginsEmptyTip"
                                     Symbol="🧩"
                                     StopTip="{x:Bind Texts['NothingHere'], Mode=OneWay}"
                                     StopDescription="{x:Bind Texts['ComponentManager_EmptyPlugins'], Mode=OneWay}"
                                     ButtonText="{x:Bind Texts['ComponentManager_AddPlugin'], Mode=OneWay}"
                                     ButtonCommand="{x:Bind AddComponentCommand, Mode=OneWay}" />
                </Grid>
            </muxc:TabViewItem>
        </muxc:TabView>
        <ge:StopTipLayer x:Name="UnsupportedTip" Grid.Row="1"
                         Symbol="🧰"
                         StopTip="{x:Bind Texts['FuncDisabled'], Mode=OneWay}"
                         StopDescription="{x:Bind Texts['ComponentManager_Unsupported'], Mode=OneWay}"
                         ButtonText="{x:Bind Texts['Refresh'], Mode=OneWay}"
                         ButtonCommand="{x:Bind RefreshCommand, Mode=OneWay}"
                         Visibility="Collapsed" />
        <TextBlock x:Name="ComponentsStateText" Grid.Row="1" VerticalAlignment="Bottom" Margin="8" TextWrapping="Wrap" Opacity="0.72" IsHitTestVisible="False" Visibility="Collapsed" />
        <ge:LoadingLayer x:Name="ComponentLoadingLayer" Grid.RowSpan="2" Visibility="Collapsed" />
    </Grid>
</UserControl>
