<UserControl
    x:Class="MCServerLauncher.WinUI.InstanceConsole.View.Pages.FileManagerPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:editor="using:WinUIEditor"
    xmlns:models="using:MCServerLauncher.WinUI.Models"
    xmlns:pages="using:MCServerLauncher.WinUI.InstanceConsole.View.Pages"
    xmlns:components="using:MCServerLauncher.WinUI.Views.Components.Generic">
    <Grid Padding="16" RowSpacing="10">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <muxc:InfoBar x:Name="MultiSelectTipBar" Grid.Row="0" IsOpen="True" IsClosable="True" Severity="Informational" Message="{x:Bind Texts['MultiSelectTip'], Mode=OneWay}" Closed="MultiSelectTipBar_Closed" />
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="BackButton" Click="NavigateBack_Click" ToolTipService.ToolTip="{x:Bind Texts['Back'], Mode=OneWay}"><SymbolIcon Symbol="Back" /></Button>
                <Button x:Name="ForwardButton" Click="NavigateForward_Click"><SymbolIcon Symbol="Forward" /></Button>
                <Button Click="NavigateUp_Click"><SymbolIcon Symbol="Up" /></Button>
                <TextBox x:Name="CurrentPathTextBox" Text="/" PlaceholderText="{x:Bind Texts['FileName'], Mode=OneWay}" Width="420" KeyDown="CurrentPathTextBox_KeyDown" />
                <Button Content="{x:Bind Texts['Open'], Mode=OneWay}" Click="LoadFile_Click" />
                <Button Content="{x:Bind Texts['Refresh'], Mode=OneWay}" Click="RefreshDirectory_Click" />
                <Button Content="{x:Bind Texts['CreateDirectory'], Mode=OneWay}" Click="CreateDirectory_Click" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="{x:Bind Texts['UploadFile'], Mode=OneWay}" Click="Upload_Click" />
                <Button Content="{x:Bind Texts['Download'], Mode=OneWay}" Click="Download_Click" />
                <Button Content="{x:Bind Texts['Rename'], Mode=OneWay}" Click="Rename_Click" />
                <Button Content="{x:Bind Texts['Delete'], Mode=OneWay}" Click="DeleteFile_Click" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <muxc:TreeView x:Name="DirectoryTree"
                           Grid.Column="0"
                           ItemsSource="{x:Bind DirectoryTreeItems, Mode=OneWay}"
                           ItemInvoked="DirectoryTree_ItemInvoked"
                           SelectionMode="Single"
                           Margin="0,0,8,0">
                <muxc:TreeView.ItemTemplate>
                    <DataTemplate x:DataType="pages:DirectoryNode">
                        <muxc:TreeViewItem ItemsSource="{x:Bind Children}" IsExpanded="{x:Bind IsExpanded}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" />
                            </StackPanel>
                        </muxc:TreeViewItem>
                    </DataTemplate>
                </muxc:TreeView.ItemTemplate>
            </muxc:TreeView>

            <Border Grid.Column="1"
                    Width="1"
                    Background="{ThemeResource CardStrokeColorDefaultBrush}" />

            <Grid Grid.Column="2" Margin="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid x:Name="FileListHeader" Grid.Row="0" Padding="6,0,6,4" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="180" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Texts['Name'], Mode=OneWay}" FontWeight="SemiBold" Opacity="0.6" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Texts['Size'], Mode=OneWay}" FontWeight="SemiBold" Opacity="0.6" />
                    <TextBlock Grid.Column="2" Text="{x:Bind Texts['ModifiedDate'], Mode=OneWay}" FontWeight="SemiBold" Opacity="0.6" />
                </Grid>

                <ListView Grid.Row="1"
                          x:Name="RemoteFilesList"
                          ItemsSource="{x:Bind Files, Mode=OneWay}"
                          SelectionMode="Extended"
                          DoubleTapped="FilesList_DoubleTapped">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:RemoteFileModel">
                            <Grid Padding="6" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="180" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="{x:Bind IconGlyph, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind SizeText, Mode=OneWay}" Opacity="0.72" />
                                <TextBlock Grid.Column="2" Text="{x:Bind ModifiedText, Mode=OneWay}" Opacity="0.72" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="{x:Bind Texts['Open'], Mode=OneWay}" Click="OpenItem_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="{x:Bind Texts['Download'], Mode=OneWay}" Click="Download_Click" />
                            <MenuFlyoutItem Text="{x:Bind Texts['UploadFile'], Mode=OneWay}" Click="Upload_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="{x:Bind Texts['Rename'], Mode=OneWay}" Click="Rename_Click" />
                            <MenuFlyoutItem Text="{x:Bind Texts['Delete'], Mode=OneWay}" Click="DeleteFile_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="{x:Bind Texts['CreateDirectory'], Mode=OneWay}" Click="CreateDirectory_Click" />
                            <MenuFlyoutItem Text="{x:Bind Texts['Refresh'], Mode=OneWay}" Click="RefreshDirectory_Click" />
                        </MenuFlyout>
                    </ListView.ContextFlyout>
                </ListView>

                <components:StopTipLayer x:Name="EmptyStateLayer" Grid.RowSpan="2" Visibility="Collapsed" />
            </Grid>
        </Grid>
        <Grid Grid.Row="3" RowSpacing="8">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="RemotePathTextBox" Header="{x:Bind Texts['FileName'], Mode=OneWay}" Width="420" />
                <Button Content="{x:Bind Texts['Save'], Mode=OneWay}" Click="SaveFile_Click" />
                <Button Content="{x:Bind Texts['Reload'], Mode=OneWay}" Click="ReloadFile_Click" />
                <Button x:Name="EncodingButton" Click="ChangeEncoding_Click" MinWidth="180" />
                <TextBox x:Name="SearchTextBox" PlaceholderText="{x:Bind Texts['Search'], Mode=OneWay}" Width="220" KeyDown="SearchTextBox_KeyDown" />
                <Button Content="{x:Bind Texts['Search'], Mode=OneWay}" Click="FindNext_Click" />
            </StackPanel>
            <editor:CodeEditorControl Grid.Row="1" x:Name="EditorControl" HighlightingLanguage="text" />
        </Grid>
        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8">
            <Button Content="{x:Bind Texts['Undo'], Mode=OneWay}" Click="Undo_Click" />
            <Button Content="{x:Bind Texts['Redo'], Mode=OneWay}" Click="Redo_Click" />
            <Button Content="{x:Bind Texts['Copy'], Mode=OneWay}" Click="Copy_Click" />
            <Button Content="{x:Bind Texts['Paste'], Mode=OneWay}" Click="Paste_Click" />
            <Button Content="{x:Bind Texts['SelectAll'], Mode=OneWay}" Click="SelectAll_Click" />
            <Button Content="{x:Bind Texts['ZoomOut'], Mode=OneWay}" Click="ZoomOut_Click" />
            <Button Content="{x:Bind Texts['ZoomIn'], Mode=OneWay}" Click="ZoomIn_Click" />
            <TextBlock x:Name="EditorStateText" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
