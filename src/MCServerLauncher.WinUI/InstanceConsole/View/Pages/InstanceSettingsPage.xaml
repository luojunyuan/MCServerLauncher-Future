<UserControl
    x:Class="MCServerLauncher.WinUI.InstanceConsole.View.Pages.InstanceSettingsPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MCServerLauncher.WinUI.Models">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24" Spacing="12">
            <TextBlock Text="{x:Bind Texts['Console_InstanceSettingsNavMenu'], Mode=OneWay}" Style="{StaticResource SectionHeaderTextBlockStyle}" />
            <TextBlock x:Name="InstanceIdTextBlock" Opacity="0.72" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="BasicModeNotice" Text="{x:Bind Texts['InstanceSettingsBasicModeNotice'], Mode=OneWay}" TextWrapping="Wrap" Opacity="0.72" />
            <TextBox x:Name="InstanceNameSettingsTextBox" Header="{x:Bind Texts['InstanceName'], Mode=OneWay}" />
            <ComboBox x:Name="InstanceTypeBox" Header="{x:Bind Texts['InstanceType'], Mode=OneWay}" SelectionChanged="InstanceType_SelectionChanged" />
            <TextBox x:Name="VersionSettingsTextBox" Header="{x:Bind Texts['Version'], Mode=OneWay}" />
            <Grid x:Name="JavaRuntimeSection" ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox x:Name="JavaPathSettingsTextBox" Header="{x:Bind Texts['JavaPath'], Mode=OneWay}" />
                <Button x:Name="ScanJavaButton" Grid.Column="1" Content="{x:Bind Texts['Search'], Mode=OneWay}" Click="ScanJava_Click" VerticalAlignment="Bottom" />
            </Grid>
            <StackPanel x:Name="JvmArgumentsSection" Spacing="12">
                <TextBlock Text="{x:Bind Texts['CreateInstance_MinecraftJavaJvmArgument_Title'], Mode=OneWay}" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                <TextBlock Text="{x:Bind Texts['CreateInstance_MinecraftJavaJvmArgument_Description'], Mode=OneWay}" TextWrapping="Wrap" Opacity="0.72" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="NewArgumentTextBox" Grid.Column="0" PlaceholderText="{x:Bind Texts['CreateInstance_MinecraftJavaJvmArgument_Title'], Mode=OneWay}" />
                    <Button x:Name="AddArgumentButton" Grid.Column="1" Content="{x:Bind Texts['Add'], Mode=OneWay}" Click="AddArgument_Click" />
                    <Button Grid.Column="2" Content="{x:Bind Texts['JvmArgHelper'], Mode=OneWay}" Click="Helper_Click" />
                </Grid>
                <ListView x:Name="JvmArgumentsList" ItemsSource="{x:Bind Arguments, Mode=OneWay}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:JvmArgumentItemModel">
                            <Grid ColumnSpacing="8" Padding="0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox Text="{x:Bind Argument, Mode=TwoWay}" />
                                <Button Grid.Column="1" Content="{x:Bind Texts['Delete'], Mode=OneWay}" Tag="{x:Bind Mode=OneTime}" Click="RemoveArgument_Click" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
            <StackPanel x:Name="CoreReplacementSection" Spacing="12">
                <TextBlock Text="{x:Bind Texts['CorePath'], Mode=OneWay}" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                <TextBlock x:Name="TargetText" TextWrapping="Wrap" Opacity="0.72" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="ReplacementCoreTextBox" Grid.Column="0" IsReadOnly="True" TextWrapping="Wrap" />
                    <Button x:Name="SelectReplacementCoreButton" Grid.Column="1" Content="{x:Bind Texts['Replace'], Mode=OneWay}" Click="SelectReplacementCore_Click" />
                    <Button x:Name="ClearReplacementCoreButton" Grid.Column="2" Content="{x:Bind Texts['Cancel'], Mode=OneWay}" Click="ClearReplacementCore_Click" />
                </Grid>
            </StackPanel>
            <StackPanel x:Name="InstallerSection" Spacing="8">
                <CheckBox x:Name="ForceRerunInstallerCheckBox" Content="{x:Bind Texts['ForceRerunInstaller'], Mode=OneWay}" />
                <TextBlock Text="{x:Bind Texts['InstanceSettingsInstallerNotice'], Mode=OneWay}" TextWrapping="Wrap" Opacity="0.72" />
            </StackPanel>
            <TextBlock x:Name="InstanceSettingsStateText" TextWrapping="Wrap" Opacity="0.78" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{x:Bind Texts['Save'], Mode=OneWay}" x:Name="SaveInstanceSettingsButton" Click="Save_Click" Visibility="Collapsed" />
                <Button Content="{x:Bind Texts['Reload'], Mode=OneWay}" Click="Reload_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
