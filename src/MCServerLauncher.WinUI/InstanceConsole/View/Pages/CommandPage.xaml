<UserControl
    x:Class="MCServerLauncher.WinUI.InstanceConsole.View.Pages.CommandPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:modules="using:MCServerLauncher.WinUI.InstanceConsole.Modules">
    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind Texts['ConsoleCommand_FeedbackTip'], Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="1" Click="ToggleFullscreen_Click" AutomationProperties.AutomationId="ConsoleFullscreenButton">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE740;" FontSize="16" />
                    <TextBlock Text="{x:Bind FullscreenText, Mode=OneWay}" />
                </StackPanel>
            </Button>
            <Button Grid.Column="2" AutomationProperties.AutomationId="ConsoleActionsButton">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE712;" FontSize="16" />
                    <TextBlock Text="{x:Bind Texts['More'], Mode=OneWay}" />
                </StackPanel>
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="{x:Bind Texts['Start'], Mode=OneWay}" IsEnabled="{x:Bind CanStart, Mode=OneWay}" Click="Start_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE768;" FontSize="16" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="{x:Bind Texts['Stop'], Mode=OneWay}" IsEnabled="{x:Bind CanStop, Mode=OneWay}" Click="Stop_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE71A;" FontSize="16" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="{x:Bind Texts['Restart'], Mode=OneWay}" IsEnabled="{x:Bind CanRestart, Mode=OneWay}" Click="Restart_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE72C;" FontSize="16" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="{x:Bind Texts['Kill'], Mode=OneWay}" IsEnabled="{x:Bind CanKill, Mode=OneWay}" Click="Kill_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE711;" FontSize="16" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>
        <ListView x:Name="LogList"
                  Grid.Row="1"
                  Margin="0,10,0,0"
                  SelectionMode="Single"
                  IsItemClickEnabled="False"
                  IsTabStop="False"
                  Background="Transparent">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="modules:LogEntry">
                    <TextBlock Text="{x:Bind Text}" FontFamily="Consolas" TextWrapping="Wrap" />
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="{x:Bind Texts['Copy'], Mode=OneWay}" Click="CopyLog_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8C8;" FontSize="16" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="{x:Bind Texts['SelectAll'], Mode=OneWay}" Click="SelectAllLog_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="{x:Bind FullscreenText, Mode=OneWay}" Click="ToggleFullscreen_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE740;" FontSize="16" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </ListView.ContextFlyout>
        </ListView>
        <Grid Grid.Row="2" ColumnSpacing="10" Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox x:Name="CommandTextBox" PlaceholderText="{x:Bind Texts['ConsoleCommand_EnterCommandTip'], Mode=OneWay}" KeyDown="CommandTextBox_KeyDown" />
            <Button Grid.Column="1" IsEnabled="{x:Bind CanSendCommand, Mode=OneWay}" Click="SendCommand_Click" AutomationProperties.AutomationId="ConsoleSendCommandButton">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE724;" FontSize="16" />
                    <TextBlock Text="{x:Bind Texts['ConsoleCommand_EventTrigger_SendCommand'], Mode=OneWay}" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
