<UserControl
    x:Class="MCServerLauncher.WinUI.InstanceConsole.View.Pages.BoardPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:MCServerLauncher.Common.ProtoType.Instance">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32,20" Spacing="10">
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Texts['ConsoleBoard_Universal_RAM'], Mode=OneWay}" VerticalAlignment="Center" />
                        <TextBlock x:Name="MemoryStatusTextBlock" Grid.Column="2" Text="0 MB" TextAlignment="Right" />
                    </Grid>
                    <ProgressBar x:Name="MemoryStatusProgressBar" Grid.Row="1" Maximum="100" Value="0" />
                </Grid>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Texts['ConsoleBoard_Universal_CPU'], Mode=OneWay}" VerticalAlignment="Center" />
                        <TextBlock x:Name="CpuStatusTextBlock" Grid.Column="2" Text="0 %" TextAlignment="Right" />
                    </Grid>
                    <ProgressBar x:Name="CpuStatusProgressBar" Grid.Row="1" Maximum="100" Value="0" />
                </Grid>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Texts['ConsoleBoard_Universal_WebSocketLatency'], Mode=OneWay}" />
                    <TextBlock x:Name="WebSocketPingStatusTextBlock" Grid.Column="1" Text="-- ms" TextAlignment="Right" />
                </Grid>
            </Border>
            <Border x:Name="AddressCard" Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Texts['ConsoleBoard_Minecraft_ServerIP_Title'], Mode=OneWay}" VerticalAlignment="Center" />
                    <TextBox x:Name="AddressTextBox" Grid.Column="1" IsReadOnly="True" Visibility="Collapsed" MinWidth="180" />
                    <Button x:Name="ToggleAddressButton" Grid.Column="2" Content="{x:Bind Texts['ClickToView'], Mode=OneWay}" Click="ToggleAddress_Click" AutomationProperties.AutomationId="InstanceAddressToggleButton" />
                </Grid>
            </Border>
            <Border x:Name="PlayerCard" Style="{StaticResource CardBorderStyle}">
                <Grid RowSpacing="8">
                    <TextBlock Text="{x:Bind Texts['ConsoleBoard_Minecraft_ServerPlayersList_Title'], Mode=OneWay}" />
                    <ListView x:Name="PlayerListView" Grid.Row="1" IsItemClickEnabled="False" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="common:Player">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="PlayerIpText" Grid.Column="1" VerticalAlignment="Center" Visibility="Collapsed" />
                                    <Button Grid.Column="2" Click="TogglePlayerIp_Click" Padding="10,4" VerticalAlignment="Center">
                                        <FontIcon x:Name="TogglePlayerIpIcon" Glyph="&#xE890;" FontSize="14" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
